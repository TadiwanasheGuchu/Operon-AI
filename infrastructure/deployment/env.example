# Production/staging settings for compose.production.yml. Copy to <environment>.env on the host
# (never commit real values). Secrets belong in your secret manager; this file is the fallback.
OPERON_ENVIRONMENT=production
OPERON_DATABASE_URL=postgresql+asyncpg://operon_app:CHANGE_ME@db.internal:5432/operon
OPERON_MIGRATIONS_DATABASE_URL=postgresql+psycopg://operon_owner:CHANGE_ME@db.internal:5432/operon
OPERON_REDIS_URL=rediss://:CHANGE_ME@redis.internal:6379/0
OPERON_SECRET_KEYS=v1:GENERATE_WITH_openssl_rand_-base64_32
OPERON_WEB_BASE_URL=https://operon.example.com
# smtp, or brevo (HTTPS API; for hosts that block SMTP ports) with OPERON_BREVO_API_KEY.
OPERON_EMAIL_BACKEND=smtp
OPERON_EMAIL_FROM=Operon <no-reply@example.com>
OPERON_SMTP_HOST=smtp.example.com
OPERON_SMTP_PORT=587
OPERON_SMTP_USERNAME=
OPERON_SMTP_PASSWORD=
OPERON_SMTP_STARTTLS=true
OPERON_TEMPORAL_ADDRESS=temporal.internal:7233
OPERON_TEMPORAL_NAMESPACE=operon-production
# Observability (optional): OpenTelemetry over OTLP/HTTP.
OPERON_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.internal:4318
# AI (optional): providers are offered only when a key is set; organisations opt in.
OPERON_ANTHROPIC_API_KEY=
OPERON_OPENAI_API_KEY=
OPERON_OPENAI_MODEL=
