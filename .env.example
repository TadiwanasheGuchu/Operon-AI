# Copy to .env for local overrides. Never commit .env. Values here are local-development defaults.

# --- API (apps/api, prefix OPERON_) ---
OPERON_ENVIRONMENT=development
# Runtime role: least privilege, no BYPASSRLS.
OPERON_DATABASE_URL=postgresql+asyncpg://operon_app:operon_app_dev@localhost:5432/operon
# Schema owner: used only by Alembic migrations.
OPERON_MIGRATIONS_DATABASE_URL=postgresql+psycopg://operon_owner:operon_owner_dev@localhost:5432/operon
OPERON_REDIS_URL=redis://localhost:6379/0
OPERON_LOG_LEVEL=INFO
# true = JSON logs (deployed); false = readable console output.
OPERON_LOG_JSON=false

# Public URL of the web app, used in email links.
OPERON_WEB_BASE_URL=http://localhost:3000

# Encryption keys for secrets at rest: "<id>:<base64 of 32 random bytes>", comma-separated,
# newest first. Generate with: python -c "import os,base64;print('v2:'+base64.b64encode(os.urandom(32)).decode())"
# Leave unset in development to use the built-in development key (refused in staging/production).
# OPERON_SECRET_KEYS=

# Sessions (ADR 0001). Cookies are Secure everywhere except development/test.
OPERON_SESSION_IDLE_MINUTES=60
OPERON_SESSION_ABSOLUTE_HOURS=12

# Email: console (prints to the API log), smtp (Mailpit locally, a real relay when deployed).
OPERON_EMAIL_BACKEND=console
# "smtp", or "brevo" (Brevo's HTTPS API, for hosts that block SMTP ports; needs OPERON_BREVO_API_KEY).
OPERON_EMAIL_FROM=Operon <no-reply@operon.local>
OPERON_SMTP_HOST=localhost
OPERON_SMTP_PORT=1025
# OPERON_SMTP_USERNAME=
# OPERON_SMTP_PASSWORD=
OPERON_SMTP_STARTTLS=false

# Integrations and background work (ADR 0003, 0010).
# "inline" runs syncs inside the API process (development/test only, no schedules);
# "temporal" starts durable workflows on the worker (required in staging/production).
OPERON_WORKFLOW_BACKEND=inline
OPERON_TEMPORAL_ADDRESS=localhost:7233
OPERON_TEMPORAL_NAMESPACE=default
OPERON_SYNC_INTERVAL_MINUTES=15
# Allow integration URLs on private networks (e.g. a local Odoo). Development only.
OPERON_ALLOW_PRIVATE_INTEGRATION_HOSTS=false

# --- Web (apps/web) ---
# Where the Next.js server forwards /api/* (server-side only).
OPERON_API_ORIGIN=http://localhost:8000
# "api" (default): real sign-in and data. "demo": signed-out design preview with fictional data.
NEXT_PUBLIC_OPERON_DATA_SOURCE=api

# --- Docker Compose ---
POSTGRES_SUPERUSER_PASSWORD=postgres_dev

# --- AI explanations (optional; ADR 0006, ADR 0011) ---
# A provider is offered to organisations only when its key is set. Organisations must still opt in.
# OPERON_ANTHROPIC_API_KEY=
# OPERON_ANTHROPIC_MODEL=claude-opus-5-5
# OPERON_OPENAI_API_KEY=
# OPERON_OPENAI_MODEL=            # required with the OpenAI key; no default
# OPERON_AI_TIMEOUT_SECONDS=60
# In-process incident escalation interval when OPERON_WORKFLOW_BACKEND=inline (0 disables).
# OPERON_INLINE_MAINTENANCE_INTERVAL_SECONDS=60

# --- Observability (optional; ADR 0015) ---
# Export traces and metrics over OTLP/HTTP. Trace ids are added to logs when enabled.
# OPERON_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OPERON_SERVICE_NAME=operon-api
